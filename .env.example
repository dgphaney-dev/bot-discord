# ========================================================
# EXEMPLO DE CONFIGURAÇÕES (.env.example)
# Copie para .env e preencha com seus dados reais.
# ========================================================

DISCORD_TOKEN=seu_token_aqui
BOT_PREFIX=!
BOT_STATUS=online
BOT_ATIVIDADE=Meu prefixo é !
CARGO_MUTE_NOME=Mutado
CARGO_PERM_MUTE=mute
LIMITE_PURGE_MAX=500
VIP_CARGO_PRATA=VIP Prata
VIP_CARGO_GOLD=VIP Gold
VIP_CARGO_DIAMANTE=VIP Diamante
VIP_LIMITE_PRATA=1
VIP_LIMITE_GOLD=3
VIP_LIMITE_DIAMANTE=5
VIP_CATEGORIA_CALLS=Calls VIP
TEMPO_DELETE_ERRO=10
TEMPO_DELETE_SUCESSO=15
TEMPO_DELETE_VIP=60
AUTO_DELETE_COMANDOS=true

# Cores dos Embeds (Hexadecimal)
COR_EMBED_SUCESSO=#00FF22
COR_EMBED_ERRO=#ED4245
COR_EMBED_AVISO=#FFCC00
COR_EMBED_INFO=#00C3FF
COR_EMBED_MODERACAO=#B700FF
COR_EMBED_PADRAO=#5865F2

# Cores dos Níveis VIP
COR_VIP_PRATA=#C0C0C0
COR_VIP_GOLD=#FFD700
COR_VIP_DIAMANTE=#00E5FF

# Gemini AI (https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODELO=gemini-1.5-flash
IA_MAX_HISTORICO=10

